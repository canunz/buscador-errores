[Unit]
Description=DimaBug QA pilot - shared MySQL - simulated replies
After=network.target mysql.service dimabug-wa-pilot-graph.service
Wants=dimabug-wa-pilot-graph.service
StartLimitIntervalSec=600
StartLimitBurst=3
ConditionPathExists=/etc/dimabug-wa-pilot/PILOT_APPROVED

[Service]
Type=simple
User=dimabug-wa-pilot
Group=dimabug-wa-pilot
WorkingDirectory=/var/lib/dimabug-wa-pilot
LoadCredential=application.properties:/etc/dimabug-wa-pilot/application.properties
LoadCredential=mysql-truststore.p12:/etc/dimabug-wa-pilot/mysql-truststore.p12
LoadCredential=spring.datasource.password:/etc/dimabug-wa-pilot/secrets/spring.datasource.password
LoadCredential=dimabug.whatsapp.meta-qa.verify-token:/etc/dimabug-wa-pilot/secrets/verify-token
LoadCredential=dimabug.whatsapp.meta-qa.app-secret:/etc/dimabug-wa-pilot/secrets/app-secret
LoadCredential=dimabug.whatsapp.durable.clave-cifrado:/etc/dimabug-wa-pilot/secrets/clave-cifrado
LoadCredential=dimabug.whatsapp.durable.clave-hmac:/etc/dimabug-wa-pilot/secrets/clave-hmac
LoadCredential=jwt.secret:/etc/dimabug-wa-pilot/secrets/jwt-secret
LoadCredential=spring.security.user.password:/etc/dimabug-wa-pilot/secrets/security-password
ExecStart=/usr/bin/java -Xms64m -Xmx192m -XX:MaxDirectMemorySize=48m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:+ExitOnOutOfMemoryError -jar /opt/dimabug-wa-pilot/whatsapp-qa.jar --spring.config.location=file:%d/application.properties --spring.config.import=configtree:%d/
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=45s
KillMode=control-group
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
CPUWeight=25
IOWeight=25
TasksMax=96
LimitNOFILE=4096
UMask=0077
StateDirectory=dimabug-wa-pilot
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
