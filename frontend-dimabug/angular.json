{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "buscador-errores": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/buscador-errores",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "ocr/v7"
              },
              {
                "glob": "tesseract-core*-lstm.wasm*",
                "input": "node_modules/tesseract.js-core",
                "output": "ocr/v7/core"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "ocr/v7/idiomas"
              },
              {
                "glob": "spa.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/spa/4.0.0_best_int",
                "output": "ocr/v7/idiomas"
              }
            ],
            "styles": [
              "@fontsource/inter/400.css",
              "@fontsource/inter/500.css",
              "@fontsource/inter/600.css",
              "@fontsource/inter/700.css",
              "src/styles.css"
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "qa-local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputPath": "dist/qa-local",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa-local.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "buscador-errores:build:production"
            },
            "development": {
              "buildTarget": "buscador-errores:build:development"
            },
            "qa-local": {
              "buildTarget": "buscador-errores:build:qa-local",
              "proxyConfig": "proxy.qa-local.json",
              "host": "127.0.0.1",
              "port": 14200
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "ocr/v7"
              },
              {
                "glob": "tesseract-core*-lstm.wasm*",
                "input": "node_modules/tesseract.js-core",
                "output": "ocr/v7/core"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "ocr/v7/idiomas"
              },
              {
                "glob": "spa.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/spa/4.0.0_best_int",
                "output": "ocr/v7/idiomas"
              },
              {
                "glob": "*.png",
                "input": "src/test-assets/ocr",
                "output": "test-ocr"
              }
            ],
            "styles": [
              "@fontsource/inter/400.css",
              "@fontsource/inter/500.css",
              "@fontsource/inter/600.css",
              "@fontsource/inter/700.css",
              "src/styles.css"
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "636ee94b-90e5-41cd-8723-7784438edd91"
  }
}
