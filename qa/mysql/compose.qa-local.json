{
  "name": "dimabug-qa-local-13318",
  "services": {
    "mysql": {
      "image": "mysql:8.0.46@sha256:62fb722c78b24245ddff1796a0fcee4a49cc5b87e0aaaf20c92d1da9e0a2497b",
      "platform": "linux/amd64",
      "pull_policy": "never",
      "container_name": "dimabug-qa-mvp-13318-mysql",
      "restart": "no",
      "cpus": 2.0,
      "mem_limit": "4g",
      "ports": ["127.0.0.1:13318:3306"],
      "environment": {
        "MYSQL_ROOT_PASSWORD_FILE": "/run/secrets/mysql_root_password",
        "MYSQL_ROOT_HOST": "localhost"
      },
      "secrets": ["mysql_root_password"],
      "volumes": ["mysql-data:/var/lib/mysql"],
      "networks": ["qa-internal"],
      "security_opt": ["no-new-privileges:true"],
      "command": [
        "--character-set-server=utf8mb4",
        "--collation-server=utf8mb4_unicode_ci",
        "--default-time-zone=+00:00",
        "--event-scheduler=OFF",
        "--local-infile=OFF",
        "--secure-file-priv=NULL",
        "--skip-log-bin",
        "--max-connections=40",
        "--innodb-buffer-pool-size=512M"
      ]
    }
  },
  "secrets": {
    "mysql_root_password": {"file": "../runtime/secrets/mysql-root.txt"}
  },
  "volumes": {
    "mysql-data": {"name": "dimabug-qa-mvp-13318-mysql-data"}
  },
  "networks": {
    "qa-internal": {
      "name": "dimabug-qa-mvp-13318-net",
      "internal": true
    }
  }
}
