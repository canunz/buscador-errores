# PROPUESTO; requiere versión/binario/aprovisionamiento y autorización separados.
[Unit]
Description=MySQL exclusivo DimaBug WhatsApp QA
After=network.target
ConditionPathExists=/etc/dimabug-wa-qa/APPROVED
ConditionPathExists=/var/lib/dimabug-wa-qa-mysql/mysql
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=dimabug-wa-mysql
Group=dimabug-wa-mysql
ExecStart=/usr/sbin/mysqld --defaults-file=/etc/dimabug-wa-qa-mysql/mysqld.cnf
Restart=on-failure
RestartSec=15s
TimeoutStartSec=90s
TimeoutStopSec=90s
CPUQuota=50%
CPUWeight=25
IOWeight=25
MemoryHigh=384M
MemoryMax=512M
TasksMax=96
LimitNOFILE=4096
UMask=0077
StateDirectory=dimabug-wa-qa-mysql
StateDirectoryMode=0700
RuntimeDirectory=dimabug-wa-qa-mysql
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
