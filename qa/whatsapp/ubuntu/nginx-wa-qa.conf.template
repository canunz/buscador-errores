# PROPUESTO: incluir SOLO en contexto http, tras renderizar rutas TLS y nginx -t.
# Se mantiene LOOPBACK hasta autorizar explícitamente exposición pública.
log_format wa_qa_safe 'wa_qa status=$status bytes=$body_bytes_sent duration=$request_time upstream=$upstream_status';
limit_conn_zone $server_name zone=wa_qa_conns:1m;
limit_req_zone $server_name zone=wa_qa_rate:1m rate=2r/s;
map $request_uri $wa_qa_raw_ok {
    default 0;
    ~^/webhooks/whatsapp([?].*)?$ 1;
}

server {
    listen 127.0.0.1:18443 ssl;
    server_name wa-qa.dimabug.casol.cl;
    ssl_certificate __CERT_FULLCHAIN__;
    ssl_certificate_key __CERT_PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log /var/log/nginx/wa-qa.access.log wa_qa_safe;
    # Nginx puede incluir URL/query en errores upstream. No guardarlos en este vhost.
    # Auditar también error_log global/default-server antes de recibir datos reales.
    error_log /dev/null crit;
    client_max_body_size 3m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 5s;
    limit_conn wa_qa_conns 8;
    limit_conn_status 503;
    limit_req zone=wa_qa_rate burst=4 nodelay;
    limit_req_status 429;
    add_header X-WA-QA-Gateway nginx always;
    add_header Cache-Control no-store always;
    if ($host != wa-qa.dimabug.casol.cl) { return 403; }
    if ($wa_qa_raw_ok = 0) { return 403; }
    location = /webhooks/whatsapp {
        if ($request_method !~ ^(GET|POST)$) { return 403; }
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host wa-qa.dimabug.casol.cl;
        proxy_set_header Connection "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_intercept_errors off;
        # Mantener una sola marca de gateway si hay dos proxies QA encadenados.
        proxy_hide_header X-WA-QA-Gateway;
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
        client_body_buffer_size 64k;
        client_body_temp_path /var/lib/dimabug-wa-qa-nginx/body 1 2;
    }
    location / { return 403; }
}
