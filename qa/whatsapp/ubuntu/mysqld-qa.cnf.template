# PROPUESTO: segunda instancia NUEVA. Nunca cargar desde la instancia existente.
[mysqld]
port=13328
bind-address=127.0.0.1
datadir=/var/lib/dimabug-wa-qa-mysql
socket=/run/dimabug-wa-qa-mysql/mysql.sock
pid-file=/run/dimabug-wa-qa-mysql/mysql.pid
mysqlx=OFF
skip-name-resolve
default-time-zone=+00:00
character-set-server=utf8mb4
collation-server=utf8mb4_bin
max-connections=8
innodb-buffer-pool-size=128M
innodb-redo-log-capacity=128M
# Candidato probado en C.3: menor memoria, menor detalle de diagnostico SQL.
# Solo instancia QA NUEVA; no aplicar al MySQL existente.
performance-schema=OFF
table-open-cache=128
table-definition-cache=400
thread-cache-size=4
tmp-table-size=16M
max-heap-table-size=16M
temptable-max-ram=32M
# Preservar controles de durabilidad.
innodb-flush-log-at-trx-commit=1
innodb-doublewrite=ON
sync-binlog=1
local-infile=OFF
event-scheduler=OFF
skip-log-bin
general-log=OFF
slow-query-log=OFF
secure-file-priv=NULL
require-secure-transport=ON
# Aprovisionar certificados propios de ESTA instancia y SAN 127.0.0.1.
ssl-ca=/etc/dimabug-wa-qa-mysql/tls/ca.pem
ssl-cert=/etc/dimabug-wa-qa-mysql/tls/server.pem
ssl-key=/etc/dimabug-wa-qa-mysql/tls/server-key.pem
